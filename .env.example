# Copy to .env and edit. NEVER commit .env.
APP_ENV=development            # development | testing | production
LOG_LEVEL=INFO

# --- MySQL ---
MYSQL_HOST=mysql               # use "localhost" when running the API outside Docker
MYSQL_PORT=3306
MYSQL_USER=tms
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=tms
MYSQL_ROOT_PASSWORD=change-me-root   # only used by the mysql container
TEST_MYSQL_DATABASE=tms_test

# --- Redis ---
REDIS_URL=redis://redis:6379/0
